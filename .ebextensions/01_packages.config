# SECURITY (2026-08-12): HMAC_SECRET previously hardcoded here as a placeholder
# value and committed to this public repo — see README.md "Security Notes" for
# the incident and remediation. It has been rotated and removed from source.
# Set it via the EB console (Configuration -> Updates, monitoring, and logging
# -> Environment properties) or `eb setenv HMAC_SECRET=...` — never in this file.
# This also brings the file in line with CLAUDE.md rule #2: "HMAC_SECRET must
# come from environment variable — never hardcode."
option_settings:
  aws:elasticbeanstalk:application:environment:
    LOW_STOCK_THRESHOLD: "10"
    STOCKOUT_WINDOW_HOURS: "4"
